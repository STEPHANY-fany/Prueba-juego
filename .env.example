# Configuración opcional. Copia este archivo como ".env" (junto a app.py) y cambia lo que necesites.
# En Render no se usa: allí las variables se configuran en el panel de Environment.

# PIN del anfitrión (por defecto 1234).
HOST_PIN=1234

# Puerto del servidor (por defecto 5000; Render lo asigna solo).
PORT=5000

# Segundos que se espera a que un jugador desconectado vuelva (recarga, se le cayó el Wi-Fi...)
# antes de sacarlo del lobby o de dar su combate por perdido. Por defecto 45.
RECONNECT_GRACE_SECONDS=45

# Cadena aleatoria larga; solo hace falta si publicas el juego en internet.
SECRET_KEY=cambia-esta-clave
